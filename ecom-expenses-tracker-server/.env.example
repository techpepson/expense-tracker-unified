# Copy this file to .env and fill in your own values. Never commit .env.

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains special characters (@ : / # %), URL-encode them (@ becomes %40).
DATABASE_URL=postgresql+psycopg://ecom:your_password@localhost:5432/ecom_expenses

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend addresses allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Shown on reports
ORGANISATION_NAME=e-Com Services
CURRENCY=GHS

# Used once by `python -m app.seed` to create the first admin. Change the password.
FIRST_ADMIN_NAME=System Administrator
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
